#!/usr/bin/env bash
# Configure Nginx to display a custom 404 error page

if ! command -v nginx >/dev/null 2>&1
then
    sudo apt-get update
    sudo apt-get install -y nginx
fi

echo "Ceci n'est pas une page"

echo "Ceci n'est pas une page" | sudo tee /var/www/html/404.html

if ! sudo grep -q "error_page 404 /404.html;" /etc/nginx/sites-available/default
then
    sudo sed -i '/server_name _;/a\
    error_page 404 /404.html;' /etc/nginx/sites-available/default
fi

sudo nginx -t && sudo service nginx restart
