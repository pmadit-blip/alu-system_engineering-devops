#!/usr/bin/env bash
# Installs HAProxy and configures it to round-robin traffic between web-01 and web-02

STUDENT_ID="7335"
WEB01_IP="35.179.77.152"
WEB02_IP="18.133.238.148"

sudo apt-get update -y
sudo apt-get install -y haproxy

sudo tee /etc/haproxy/haproxy.cfg > /dev/null << CFGEOF
global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin
    stats timeout 30s
    user haproxy
    group haproxy
    daemon

defaults
    log global
    mode http
    option httplog
    option dontlognull
    timeout connect 5000
    timeout client 50000
    timeout server 50000

frontend http-front
    bind *:80
    default_backend web-backend

backend web-backend
    balance roundrobin
    server ${STUDENT_ID}-web-01 ${WEB01_IP}:80 check
    server ${STUDENT_ID}-web-02 ${WEB02_IP}:80 check
CFGEOF

# Make HAProxy manageable via its init script and start on boot
sudo sed -i 's/^ENABLED=0/ENABLED=1/' /etc/default/haproxy 2>/dev/null
sudo systemctl enable haproxy 2>/dev/null
sudo service haproxy restart
