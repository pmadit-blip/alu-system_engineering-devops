#!/usr/bin/env bash
# Installs Nginx and adds an X-Served-By header containing the server hostname
# shellcheck disable=SC2154

sudo apt-get update -y
sudo apt-get install -y nginx

# Remove any older X-Served-By lines so the header is only sent once
sudo grep -rl "X-Served-By" /etc/nginx | xargs -r sudo sed -i '/X-Served-By/d'

# Add the header for every site (conf.d files load inside the http block)
sudo tee /etc/nginx/conf.d/custom_http_response_header.conf > /dev/null << 'EOF'
add_header X-Served-By $hostname;
EOF

sudo nginx -t
sudo service nginx restart
