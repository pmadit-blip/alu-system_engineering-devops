#!/usr/bin/env bash
# Configure Nginx to return the server hostname in its HTTP response header.
# shellcheck disable=SC2154

set -euo pipefail

SERVER_HOSTNAME="$(hostname)"

# Install Nginx
sudo apt-get update -y
sudo DEBIAN_FRONTEND=noninteractive apt-get install -y nginx

# Configure the custom HTTP response header
printf 'add_header X-Served-By "%s" always;\n' "$SERVER_HOSTNAME" |
    sudo tee /etc/nginx/conf.d/0-custom-http-response-header.conf > /dev/null

# Validate the Nginx configuration
sudo nginx -t

# Enable and restart Nginx
sudo systemctl enable nginx
sudo systemctl restart nginx

echo "Successfully configured X-Served-By: ${SERVER_HOSTNAME}"
