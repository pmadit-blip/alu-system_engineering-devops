#!/usr/bin/env bash
# Configure Nginx to return a custom HTTP response header.
# shellcheck disable=SC2154

set -e

HOSTNAME=$(hostname)
NGINX_CONFIG="/etc/nginx/sites-available/default"

# Install Nginx
sudo apt-get update -y
sudo apt-get install -y nginx

# Add the custom header to the default server block
if sudo grep -q "add_header X-Served-By" "$NGINX_CONFIG"; then
    sudo sed -i "s|^[[:space:]]*add_header X-Served-By .*;|        add_header X-Served-By ${HOSTNAME} always;|" "$NGINX_CONFIG"
else
    sudo sed -i "/server_name _;/a\\        add_header X-Served-By ${HOSTNAME} always;" "$NGINX_CONFIG"
fi

# Test and restart Nginx
sudo nginx -t
sudo systemctl enable nginx
sudo systemctl restart nginx

echo "Configured X-Served-By: ${HOSTNAME}"
