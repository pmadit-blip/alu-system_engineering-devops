#!/usr/bin/env bash
# Run Nginx as the nginx user and listen on port 8080
sed -i 's/listen 80 /listen 8080 /' /etc/nginx/sites-enabled/default
sed -i 's/]:80 /]:8080 /' /etc/nginx/sites-enabled/default
chown -R nginx:nginx /var/log/nginx /var/cache/nginx /var/lib/nginx
pkill nginx || true
su -s /bin/sh nginx -c '/usr/sbin/nginx'
ps aux | grep '[n]ginx'
curl -I http://127.0.0.1:8080
