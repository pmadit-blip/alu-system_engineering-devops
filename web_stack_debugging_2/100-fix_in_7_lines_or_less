#!/usr/bin/env bash
# Configure Nginx to run as nginx and listen on port 8080
getent passwd nginx || useradd -r -s /usr/sbin/nologin nginx
sed -i 's/www-data/nginx/' /etc/nginx/nginx.conf
sed -i 's/listen 80 /listen 8080 /' /etc/nginx/sites-enabled/default
sed -i 's/\[::\]:80 /[::]:8080 /' /etc/nginx/sites-enabled/default
service nginx restart
ps -ef | grep '[n]ginx'
