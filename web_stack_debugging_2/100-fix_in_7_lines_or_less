#!/usr/bin/env bash
# Configure Nginx to run as nginx and listen on port 8080
sed -i -e 's/listen 80\([ ;]\)/listen 8080\1/' -e 's/]:80\([ ;]\)/]:8080\1/' /etc/nginx/sites-enabled/default
chown -R nginx:nginx /var/log/nginx /var/cache/nginx /var/lib/nginx
install -o nginx -g nginx /dev/null /run/nginx.pid
pkill nginx || true
su -s /bin/sh nginx -c '/usr/sbin/nginx'
