#!/usr/bin/env bash
# Configure Nginx to run as nginx and listen on port 8080
getent passwd nginx >/dev/null || useradd --system --no-create-home --shell /usr/sbin/nologin nginx
sed -i 's/www-data/nginx/g' /etc/nginx/nginx.conf
sed -i 's/listen 80 /listen 8080 /' /etc/nginx/sites-enabled/default
sed -i 's/]:80 /]:8080 /' /etc/nginx/sites-enabled/default
service nginx stop
service nginx start
